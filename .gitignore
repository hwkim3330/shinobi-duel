# Blender: the .blend is kept (13 MB); its raw Poly Haven textures, derived maps and AO bakes are
# regenerated by tools/blender (fetch_polyhaven.mjs, prep_textures.py, bake_ao.py), and the cache
# holds the ~80 MB unpacked exports.
blender/cache/
blender/tex/

# Raw Mixamo downloads (Adobe terms: no redistribution of the raw files). The converted GLBs in
# public/assets/chars/ ship with the game; MANIFEST.md lists what was downloaded.
assets/mixamo/*
!assets/mixamo/MANIFEST.md
*.fbx

# Big third-party source packs (the list and licences stay)
assets/source/*
!assets/source/LICENSES.md

# netplay / capture output
shots/
server/node_modules/
